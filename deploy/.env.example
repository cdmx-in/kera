# ./init.sh writes this file with random secrets. By hand: copy it to .env and fill in the blanks.
KERA_DB_PASSWORD=         # any password, e.g. openssl rand -hex 12
KERA_SECRET_KEY=          # openssl rand -hex 32  (encrypts stored API keys; rotating it signs everyone out)
KERA_URL=http://localhost:8080
# The first admin, created at the first start only while Kera has no users. Delete both lines afterwards.
# KERA_ADMIN_EMAIL=you@example.com
# KERA_ADMIN_PASSWORD=      # 10 or more characters
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Optional profiles, comma separated: ollama (models in the stack) and litellm (gateway + spend log)
# COMPOSE_PROFILES=ollama,litellm
# OLLAMA_BASE_URL=http://ollama:11434     # with the ollama profile
LITELLM_MASTER_KEY=       # litellm profile: sk-<random>, e.g. sk-$(openssl rand -hex 16)
LITELLM_DB_PASSWORD=      # litellm profile: openssl rand -hex 12 (letters and digits only)
# OPENAI_API_KEY=         # for hosted models listed in litellm/config.yaml
# ANTHROPIC_API_KEY=

# Other ports and the image, if the defaults do not suit you
# KERA_PORT=8080
# LITELLM_PORT=4000
# KERA_IMAGE=ghcr.io/cdmx-in/kera:latest
