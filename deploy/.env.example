# ./init.sh writes this file with random secrets. By hand: copy it to .env and fill in the blanks.
KERA_DB_PASSWORD=         # any password, e.g. openssl rand -hex 12
KERA_SECRET_KEY=          # openssl rand -hex 32  (encrypts stored API keys; rotate it with `kera secrets rotate`, docs/deploy.md; keep it apart from data backups)
KERA_URL=http://localhost:8080
# The first admin, created at the first start only while Kera has no users. Delete both lines afterwards.
# KERA_ADMIN_EMAIL=you@example.com
# KERA_ADMIN_PASSWORD=      # 10 or more characters, not a common password (./init.sh makes a strong one)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Optional profiles, comma separated: ollama (models in the stack), litellm (gateway + spend log) and searxng (private web search)
# COMPOSE_PROFILES=ollama,litellm,searxng
# OLLAMA_BASE_URL=http://ollama:11434     # with the ollama profile
LITELLM_MASTER_KEY=       # litellm profile: sk-<random>, e.g. sk-$(openssl rand -hex 16)
LITELLM_DB_PASSWORD=      # litellm profile: openssl rand -hex 12 (letters and digits only)
# OPENAI_API_KEY=         # for hosted models listed in litellm/config.yaml
# ANTHROPIC_API_KEY=
# SEARXNG_SECRET=         # searxng profile: optional, a random one is made at every start when empty

# Document extraction (PDF, DOCX, PPTX, ODT, scanned pages) is the "extract" service of this stack and Kera finds it by itself.
# KERA_EXTRACTOR_URL=       # set it empty to not use the service (docs/deploy.md), or to another address to use your own
# KERA_EXTRACT_IMAGE=ghcr.io/cdmx-in/kera-extract:latest

# Pipelines that Kera runs itself use the "runner" service of this stack; it signs in with a token Kera makes, so nothing is set here.
# KERA_RUNNER_IMAGE=ghcr.io/cdmx-in/kera-runner:latest

# Only when a CDN such as Cloudflare reaches Kera over a public address: its ranges, comma separated (docs/deploy.md)
# KERA_TRUSTED_PROXIES=

# Other ports and the image, if the defaults do not suit you
# KERA_PORT=8080
# KERA_BIND=0.0.0.0        # 127.0.0.1 when a reverse proxy on this host serves HTTPS, so Kera is reachable only through it
# LITELLM_PORT=4000
# KERA_IMAGE=ghcr.io/cdmx-in/kera:latest
